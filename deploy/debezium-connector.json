{
  "name": "mdm-outbox-connector",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "tasks.max": "1",
    "database.hostname": "127.0.0.1",
    "database.port": "6431",
    "database.user": "mdm",
    "database.password": "mdm",
    "database.dbname": "mdm",
    "database.server.name": "mdm",
    "plugin.name": "pgoutput",
    "slot.name": "mdm_outbox_slot",
    "publication.autocreate.mode": "filtered",
    "table.include.list": "public.outbox_events",
    "heartbeat.interval.ms": "10000",
    "tombstones.on.delete": "false",
    "transforms": "outbox",
    "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
    "transforms.outbox.route.by.field": "aggregate_type",
    "transforms.outbox.route.topic.replacement": "outbox.${routedByValue}",
    "transforms.outbox.table.fields.event.id": "id",
    "transforms.outbox.table.fields.event.key": "aggregate_id",
    "transforms.outbox.table.fields.event.type": "event_type",
    "transforms.outbox.table.fields.event.payload": "payload",
    "transforms.outbox.table.fields.additional.placement": "headers:header,occurred_at:header",
    "binary.handling.mode": "base64"
  }
}
